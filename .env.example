# 复制成 .env 再改。都可以不填，用默认值

# 时区：决定屏幕几点醒、阿姨几点到
TZ=Asia/Shanghai
# 屏幕默认几点醒（逗号分开），网页设置里能改
WAKE_TIMES=06:00,09:30,10:45
# 几点后屏幕切到下一个阿姨来的日子，网页设置里能改
SWITCH_TIME=18:00
# 网页的外部访问地址，通知里的链接和按钮用，网页设置里也能改，比如 http://192.168.1.10:8000
MENU_PUBLIC_URL=
# 设了的话，上传固件（firmware/publish.sh）要带这个 token
MENU_ADMIN_TOKEN=
# 第一次启动不自动导入 HowToCook 菜品库就设成 0
MENU_AUTO_IMPORT=1
# 访问 GitHub 慢的话换成镜像
# HOWTOCOOK_RAW=https://raw.githubusercontent.com/Anduin2017/HowToCook/master/
